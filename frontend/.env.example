# Backend API Configuration
VITE_API_BASE_URL=http://localhost:8000/api

# Optional: Override media file base URL. Defaults to VITE_API_BASE_URL without /api
# VITE_MEDIA_BASE_URL=http://localhost:8000

# Google OAuth Configuration
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# Maps run on OpenStreetMap data via free CARTO dark-matter tiles
# (frontend/src/components/maps/shared/tileLayer.js) — no API key needed.


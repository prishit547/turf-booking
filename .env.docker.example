# ================================================================
# Env file for docker-compose.prod.yml — the full containerized stack
# (Postgres + Redis + Django/gunicorn+uvicorn + Celery worker + nginx/React).
#
# Copy to .env.docker and fill in real values:
#   cp .env.docker.example .env.docker
# Never commit .env.docker — it holds real secrets.
# ================================================================

# ----------------------------------------------------------------
# Postgres (consumed directly by the db service, and composed into
# DATABASE_URL for the backend/worker services in docker-compose.prod.yml)
# ----------------------------------------------------------------
POSTGRES_DB=boxnplay
POSTGRES_USER=boxnplay
POSTGRES_PASSWORD=change-me

# ----------------------------------------------------------------
# Django
# ----------------------------------------------------------------
# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost

# This stack's nginx (frontend/nginx.conf) terminates no TLS of its own — it
# just listens on plain :80. Leaving Django's default SECURE_SSL_REDIRECT=True
# would 301-redirect every request to an https:// that nothing here serves,
# making the whole stack unreachable. If you put a real TLS terminator (a
# cloud load balancer, managed ingress, or nginx with real certs) in front of
# this stack, remove this line (or set it to True) once that's confirmed working.
SECURE_SSL_REDIRECT=False

# Stress-testing this stack found Daphne/ASGI concurrency exhausting
# Postgres's default 100-connection limit when Django's persistent
# connections (default 600s) are used — see the comment above DATABASES in
# settings.py. 0 = close each connection after its request instead of
# accumulating them; costs a small per-request reconnect overhead in
# exchange for the backend degrading gracefully under a traffic spike
# instead of wedging Postgres for 10 minutes.
DB_CONN_MAX_AGE=0

# Number of gunicorn/uvicorn worker processes serving the backend (see
# docker-entrypoint.sh). A stress test found a single ASGI process
# CPU-saturated with throughput flat regardless of concurrency; multiple
# worker processes let concurrent requests actually run in parallel. 2 is
# tuned for docker-compose.stress.yml's default 1.3-CPU backend allocation
# (roughly workers = allocated vCPU, rounded up, +1 for headroom) — raise
# it if you give the backend container more CPU.
WEB_CONCURRENCY=2

# Celery prefork worker count — see the comment above `worker)` in
# docker-entrypoint.sh for why this needs to be set explicitly rather than
# left at Celery's own default.
CELERY_CONCURRENCY=2

GOOGLE_CLIENT_ID=
GEMINI_API_KEY=
RESERVATION_HOLD_TTL_SECONDS=300

# ----------------------------------------------------------------
# Frontend build args (baked into the JS bundle at image build time —
# see frontend/Dockerfile). Defaults below assume the nginx same-origin
# proxy setup in docker-compose.prod.yml; only change these if the
# frontend is served from a different origin than the backend.
# ----------------------------------------------------------------
VITE_API_BASE_URL=/api
VITE_GOOGLE_CLIENT_ID=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

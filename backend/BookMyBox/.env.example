# ================================================================
# BOXNPLAY ENVIRONMENT VARIABLES TEMPLATE (boxnplay.com)
# ================================================================
# Copy this file to .env and fill in your actual values
# Never commit the .env file to version control!

# ================================================================
# GOOGLE OAUTH
# ================================================================
# Get your OAuth 2.0 Client ID from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here

# ================================================================
# DJANGO SETTINGS
# ================================================================
# WARNING: must be False in any deployed/production environment. DEBUG=True
# exposes verbose stack traces and DEMO_CREDENTIALS to anyone who hits an
# error. Set to False for production!
DEBUG=True

# Generate a new secret key for production:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your_django_secret_key_here

# Comma-separated list of allowed hosts
# For production: boxnplay.com,www.boxnplay.com,api.boxnplay.com
ALLOWED_HOSTS=localhost,127.0.0.1,boxnplay.com,www.boxnplay.com,api.boxnplay.com

# ================================================================
# CORS & CSRF (Frontend & API origins)
# ================================================================
# Frontend web application origins allowed to access the API
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://boxnplay.com,https://www.boxnplay.com

# Trusted origins for CSRF protection
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://boxnplay.com,https://www.boxnplay.com,https://api.boxnplay.com

# ================================================================
# DATABASE CONFIGURATION
# ================================================================
# For SQLite (default development):
DATABASE_URL=sqlite:///db.sqlite3

# For PostgreSQL (recommended for production):
# DATABASE_URL=postgresql://username:password@localhost:5432/boxnplay

# ================================================================
# REDIS / CELERY (slot reservation + wait-queue, cache, channel layer)
# ================================================================
# One physical Redis instance is split by logical DB index /0-/3.
REDIS_URL=redis://localhost:6379

# ================================================================
# EMAIL (Resend — owner notifications, password reset, invites)
# ================================================================
# Get your API key from: https://resend.com/api-keys
# (Leave unset for local dev — emails are logged to console instead of sent)
RESEND_API_KEY=

# Verified sending domain address (e.g. notifications@boxnplay.com or onboarding@resend.dev for test)
DEFAULT_FROM_EMAIL=onboarding@resend.dev

# ================================================================
# FRONTEND CANONICAL URL
# ================================================================
# Base URL of the frontend SPA — used to build links embedded in emails
# (e.g., owner booking notifications, password reset, booking invites)
FRONTEND_URL=http://localhost:5173
# For production:
# FRONTEND_URL=https://boxnplay.com

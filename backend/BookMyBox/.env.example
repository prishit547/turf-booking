# ================================================================
# BOOKMYBOX ENVIRONMENT VARIABLES TEMPLATE
# ================================================================
# Copy this file to .env and fill in your actual values
# Never commit the .env file to version control!

# ================================================================
# GOOGLE OAUTH
# ================================================================
# Get your OAuth 2.0 Client ID from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here

# ================================================================
# GOOGLE GEMINI API
# ================================================================
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ================================================================
# DJANGO SETTINGS
# ================================================================
# WARNING: must be False in any deployed/production environment. DEBUG=True
# exposes verbose stack traces and DEMO_CREDENTIALS to anyone who hits an
# error. This file defaults to True purely for local-dev convenience —
# double-check it's False before deploying.
DEBUG=True

# Generate a new secret key for production
# You can generate one by running:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your_django_secret_key_here

# Comma-separated list of allowed hosts
ALLOWED_HOSTS=localhost,127.0.0.1

# ================================================================
# CORS (Frontend origins)
# ================================================================
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ================================================================
# DATABASE CONFIGURATION
# ================================================================
# DATABASE_URL is parsed by dj-database-url and fully drives DATABASES in
# settings.py. Leave unset (or use the sqlite line below) for zero-config
# local development. For production, set this to a real PostgreSQL URL —
# see backend/BookMyBox/DEPLOYMENT.md for details.

# For SQLite (default development)
DATABASE_URL=sqlite:///db.sqlite3

# For PostgreSQL (recommended for production)
# DATABASE_URL=postgresql://username:password@localhost:5432/bookmybox

# ================================================================
# REDIS / CELERY (slot reservation + wait-queue, cache, channel layer)
# ================================================================
# One physical Redis instance is split by logical DB index — see the
# comment above CACHES in settings.py for how /0-/3 are divided up.
# `docker compose up -d redis` starts a disposable local instance.
REDIS_URL=redis://localhost:6379
# CELERY_BROKER_URL and CELERY_RESULT_BACKEND default to REDIS_URL's /2 if unset.
# REDIS_RESERVATION_URL defaults to REDIS_URL's /3 if unset.

# ================================================================
# EMAIL CONFIGURATION (Optional)
# ================================================================
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your_email@gmail.com
# EMAIL_HOST_PASSWORD=your_app_password
